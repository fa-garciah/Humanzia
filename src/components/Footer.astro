---
import Logo from './Logo.astro';
import { site, services } from '../data/site';
---
<footer class="footer" data-tone="ciruela">
  <div class="container footer__grid">
    <div>
      <Logo size={34} />
      <p class="footer__slogan">{site.slogan}.</p>
    </div>
    <div>
      <p class="footer__head">Servicios</p>
      <ul>{services.map((s) => <li><a href={`/servicios#${s.slug}`}>{s.title}</a></li>)}</ul>
    </div>
    <div>
      <p class="footer__head">Contacto</p>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href="/contacto">Formulario de contacto</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer__legal">
    <p>© {site.year} {site.name}</p>
    <a href="/aviso-de-privacidad">Aviso de privacidad</a>
  </div>
</footer>

<style>
  .footer { background: var(--ciruela-deep); color: var(--muted); padding-block: clamp(3rem, 6vw, 4.5rem) 1.5rem; font-size: var(--fs-sm); }
  .footer :global(.logo) { color: var(--lino); }
  .footer__grid { display: grid; gap: 2rem; }
  @media (min-width: 760px) { .footer__grid { grid-template-columns: 2fr 1fr 1fr; } }
  .footer__slogan { margin-top: 1rem; max-width: 26ch; font-family: var(--font-display); font-style: italic; font-size: 1.1rem; color: var(--malva); }
  .footer__head { color: var(--lino); font-weight: 600; margin-bottom: .6rem; }
  .footer li + li { margin-top: .35rem; }
  .footer a { text-decoration: none; }
  .footer a:hover { color: var(--lino); text-decoration: underline; }
  .footer__legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--line); font-size: var(--fs-xs); }
</style>
