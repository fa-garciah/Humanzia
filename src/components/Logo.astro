---
/* Isotipo: la línea de desarrollo de una persona.
   Arranca plana (el ingreso), sube, y remata en un punto (la persona).
   El wordmark va en HTML para heredar la tipografía y el color del contenedor. */
interface Props { size?: number; wordmark?: boolean }
const { size = 30, wordmark = true } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <path d="M4 26.5h6.5c5.5 0 8.5-3.2 10.4-8.6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
    <circle cx="23.2" cy="10.4" r="3.6" fill="currentColor" />
  </svg>
  {wordmark && <span class="logo__word">Humanzia</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .5rem; color: inherit; }
  .logo__word { font-family: var(--font-display); font-size: 1.45rem; font-weight: 500; letter-spacing: -.01em; line-height: 1; }
</style>
